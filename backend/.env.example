# Copy to `.env` and adjust if needed. Defaults match docker-compose.yml.
DATABASE_URL=postgresql+psycopg://workstory:workstory@localhost:5433/workstory
TEST_DATABASE_URL=postgresql+psycopg://workstory:workstory@localhost:5433/workstory_test
LOG_LEVEL=INFO

# Local models (Ollama)
OLLAMA_URL=http://localhost:11434
CHAT_MODEL=llama3.1:8b
EMBED_MODEL=nomic-embed-text
EMBED_DIMENSIONS=768
